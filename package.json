{
  "name": "holofold",
  "private": true,
  "version": "0.1.0",
  "description": "AR origami guide: scan instruction diagrams, get a holographic fold-by-fold overlay on your live camera.",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "dev:https": "HTTPS=1 node --import tsx server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "express": "^5.3.0",
    "google-auth-library": "^10.9.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "selfsigned": "^5.5.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=20.6"
  }
}
