# Copy to .env and fill in. Needed only for scanning instructions and AI fold checks;
# the built-in models work without it.
ANTHROPIC_API_KEY=

# Optional: Sign in with Google, so profiles and badges follow the player across devices.
# Create a "Web application" OAuth client ID at https://console.cloud.google.com/apis/credentials
# and add http://localhost and http://localhost:5173 as Authorized JavaScript origins.
# Without it, players still get a guest profile (XP, badges, streaks) in each browser.
GOOGLE_CLIENT_ID=

# Optional overrides
# HOLOFOLD_MODEL=claude-opus-5-5
# PORT=5173
# SESSION_SECRET=   (otherwise a random one is created in data/session-secret)
